# ─────────────────────────────────────────────────────────────────────────────
# VisionQuant Studio — copia este archivo como .env.local y completa lo que uses.
# .env.local está en .gitignore: NUNCA subas claves a git ni las pegues en el código.
# Sin ninguna clave la app funciona en MODO DEMO/OFFLINE (incluye render real a MP4).
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic (investigación, guion, Motion Director). Modelos: claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Límite de llamadas por hora (protección de costos)
ANTHROPIC_MAX_CALLS_PER_HOUR=60

# Proveedor de texto preferido: anthropic | openai
AI_PROVIDER=anthropic

# OpenAI (opcional): texto (requiere OPENAI_MODEL explícito) y transcripción con timestamps por palabra
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ElevenLabs (opcional): voz + timestamps exactos
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Render (valores pensados para Ryzen 5 3500U / 12 GB RAM / Vega 8)
RENDER_CONCURRENCY=2
RENDER_PREVIEW_SCALE=0.5
RENDER_X264_PRESET=medium
# Vacío = Remotion descarga Chrome Headless Shell automáticamente en el primer render.
REMOTION_BROWSER_EXECUTABLE=

# Subidas
MAX_UPLOAD_MB=60

# Radar: feeds RSS/Atom separados por coma (vacío = lista oficial por defecto)
RADAR_FEEDS=

# Carpeta de datos (SQLite, media, renders). Vacío = ./data
VQ_DATA_DIR=
